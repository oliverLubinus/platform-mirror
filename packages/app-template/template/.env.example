# Local dev configuration — copy to .env (never commit .env).
# Secrets for real deploys ride the secretProvider convention (R-ENV-03:
# loadAppSecrets); AUDIT_HMAC_KEY here is the dev-only interim.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# docker compose maps the db to host port 54329
DATABASE_URL=postgresql://app:app@localhost:54329/app

# Dev-only interim (R-PKG-08: real deploys use the secretProvider convention)
AUDIT_HMAC_KEY=dev-only-not-a-secret

# Client-side auth (Vite exposes only VITE_* to the browser bundle).
# Register the dev client with auth-provider FIRST — an unknown client is
# rejected at /auth/authorize. The redirect URI must match the registration
# exactly; its pathname becomes the SPA callback route.
VITE_AUTH_API_BASE_URL=https://auth-api.staging.agentic-dna.cloud
VITE_AUTH_CLIENT_ID=app-<your-app>
VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
# Rate limiting (platform policy wrapper over express-rate-limit)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000