{
  "name": "{{APP_SLUG}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{APP_TITLE}} — platform app scaffolded from @platform/app-template (R-PKG-09).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts --env-file=.env",
    "dev:client": "vite client",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "node --import tsx --test server/src/app.test.ts client/src/auth/authClient.test.ts",
    "build": "tsc -p server/tsconfig.build.json && vite build client",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:seed": "tsx server/prisma/seed.ts --env-file=.env"
  },
  "dependencies": {
    "@platform/auth-client": "^0.2.0",
    "@platform/server-core": "^0.2.0",
    "@prisma/client": "^6.19.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}