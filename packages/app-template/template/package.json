{
  "name": "{{APP_SLUG}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{APP_TITLE}} — platform app scaffolded from @platform/app-template (R-PKG-09).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "node --watch --env-file=.env --import tsx server/src/index.ts",
    "dev:client": "vite client",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "node --import tsx --test server/src/app.test.ts server/src/openapi.test.ts server/src/permissions.test.ts server/src/errorCodes.test.ts client/src/auth/authClient.test.ts",
    "build": "prisma generate --schema server/prisma/schema.prisma && tsc -p server/tsconfig.build.json && vite build client",
    "lint": "eslint .",
    "check:whitespace": "node client/scripts/check-whitespace.cjs",
    "check:design-tokens": "node client/scripts/check-design-tokens.cjs",
    "check:contrast": "node client/scripts/check-contrast.cjs",
    "check:layering": "node client/scripts/check-layering.cjs",
    "check:bundle-secrets": "node client/scripts/check-bundle-secrets.cjs client/dist",
    "hooks:install": "node client/scripts/hooks/install-hooks.cjs",
    "check:quality-gate": "pnpm check:whitespace && pnpm check:design-tokens && pnpm check:contrast && pnpm check:layering && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle-secrets",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:seed": "node --env-file-if-exists=.env --import tsx server/prisma/seed.ts"
  },
  "dependencies": {
    "@platform/auth-client": "^0.2.0",
    "@platform/server-core": "^0.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prisma": "^7.10.1",
    "supertest": "^7.1.0",
    "yaml": "^2.6.0",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}