# @agentic-dna/* publishes to GitHub Packages (M1 registry flip).
# Scope mapping ONLY — the AUTH TOKEN must NOT live here: pnpm ignores
# env-expanded registry credentials in repository-controlled .npmrc files
# (supply-chain hardening). CI writes the token to the user-level ~/.npmrc
# from the PACKAGES_READ_TOKEN secret; locally, put the same line in your
# own ~/.npmrc (fine-grained PAT with read:packages):
#   //npm.pkg.github.com/:_authToken=<TOKEN>
@agentic-dna:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:always-auth=true
